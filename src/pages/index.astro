---
import '../styles/global.css';
import Foam from '../components/Foam.astro';
import BirthYearPanel from '../components/BirthYearPanel.astro';
import { readExplore } from '../lib/data.ts';
import { START_YEAR, END_YEAR } from '../lib/types.ts';
const ex = await readExplore();
const span = END_YEAR - START_YEAR + 1;
const og = `${Astro.site}${import.meta.env.BASE_URL.replace(/^\//, '')}og/_default.png`.replace(/([^:]\/)\/+/g, '$1');
---
<html lang="en"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Namesake — a map of American names</title>
  <meta name="description" content={`Type your name and watch its ${span}-year life story unfold. A map of American first names, ${START_YEAR}–${END_YEAR}.`} />
  <meta property="og:title" content="Namesake — a map of American names" />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body><main class="wrap">
  <Foam explore={ex} />
  <BirthYearPanel nameOfYear={ex.nameOfYear} />
</main></body></html>

<style>
  .wrap { padding-top: 22px; }
</style>
