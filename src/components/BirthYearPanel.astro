---
import type { ExploreData } from '../lib/types.ts';
const { nameOfYear } = Astro.props as { nameOfYear: ExploreData['nameOfYear'] };
const years = Object.keys(nameOfYear).map(Number).sort((a, b) => a - b);
const minY = years[0], maxY = years[years.length - 1];
const defaultY = 2000;
---
<section class="birthyear" data-birthyear data-map={JSON.stringify(nameOfYear)}>
  <div class="head">
    <h2>The names of your birth year</h2>
    <div class="control">
      <label for="by-input">Born in</label>
      <input id="by-input" type="number" min={minY} max={maxY} value={defaultY} inputmode="numeric" />
    </div>
  </div>
  <div class="cols">
    <div class="col"><div class="lab">Top boys&rsquo; names</div><div class="list" data-slot="M"></div></div>
    <div class="col"><div class="lab">Top girls&rsquo; names</div><div class="list" data-slot="F"></div></div>
  </div>
  <!-- The lists themselves used to be the live region, so every keystroke in the year box
       read out all twenty names. What actually changed is the year — so that is what is
       announced, and the lists stay where a reader can go and read them. -->
  <p class="sr" role="status" data-by-status></p>
</section>
<style>
  /* On the ground, not in a box. A bordered white card sitting under a drawn field is a
     different designer's page: the rule above it does the separating a border was doing. */
  .birthyear { margin: 8px 0 80px; padding: 30px 0 0; border-top: 1px solid var(--rule); }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .head h2 { margin: 0; font: 400 clamp(24px,3.4vw,34px)/1 var(--display); color: var(--ink); }
  .control { display: flex; align-items: center; gap: 10px; font: 400 15px/1 var(--display); font-style: italic; color: var(--ink-soft); }
  .control input { width: 96px; padding: 8px 12px; border: 1px solid var(--rule); border-radius: 10px; background: var(--ground);
    color: var(--ink); font: 400 18px/1 var(--display); font-variant-numeric: tabular-nums; }
  .control input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .lab { font: 600 11px/1 var(--mono); letter-spacing: .16em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 12px; }
  .list { display: flex; flex-direction: column; gap: 10px; }
  .list :global(a) { display: flex; align-items: center; gap: 12px;
    font: 400 clamp(20px,3vw,28px)/1.15 var(--display); color: var(--ink); text-decoration: none; width: fit-content; }
  /* the mark, at a scale shared by the six on screen — so the ranks have a size, not just an order */
  .list :global(canvas.mk) { width: 36px; height: 36px; flex: none; }
  .list :global(a:hover), .list :global(a:focus-visible) { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .list :global(a .rank) { font: 500 12px/1 var(--mono); color: var(--ink-soft); margin-right: 10px; }
  .sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 560px) { .cols { grid-template-columns: 1fr; } }
</style>
<script src="../scripts/birthyear.ts"></script>
