---
/**
 * The field: every name at once, as the front door.
 *
 * Ghosts / comebacks / the unisex line used to be three panels of six chips each. They are
 * selections over this same set of names, so they light in place here instead — same
 * mechanism as hovering, applied to a set. Nothing is lost: every chip's destination is
 * still one click away, and the reader now sees where those names sit relative to all the
 * others, which a list of six could never show.
 *
 * The hero text is markup, not overlay. It used to be positioned in `cqw` over the canvas,
 * which scales type with the ARTWORK rather than with the viewport: on a 390px phone the
 * search box started at 420px and both claim numbers loaded off the side of the screen. So
 * the same elements now sit in normal flow and are lifted onto the canvas only at the width
 * where there is room beside the field for them.
 *
 * The apparatus splits the same way. On a wide page the keys are drawn INSIDE the canvas, as
 * specimens of the marks they explain. Rendered into a phone that block reads at 6.7px, so
 * below the breakpoint the canvas keeps only the field and its era axis and the keys become
 * markup — still specimens, drawn by the same hand into their own small canvases.
 */
import type { ExploreData } from '../lib/types.ts';
const { explore } = Astro.props as { explore: ExploreData };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const modes = [
  { key: 'ghosts', label: 'Ghosts', blurb: 'Giants of their day, all but gone now.', items: explore.ghosts },
  { key: 'comebacks', label: 'Comebacks', blurb: 'Names roaring back after decades away.', items: explore.comebacks },
  { key: 'unisex', label: 'The unisex line', blurb: 'Names shared across the gender divide.', items: explore.unisex },
];
const label = 'Every American given name that ever reached 0.04% of a year’s births, 1,572 of them, ' +
  'drawn as one bubble each, sized by the largest share of a year’s births it ever took and placed ';
---
<section class="foam" data-foam data-base={base}>
  <div class="ui">
    <div class="head">
      <h1>The big names got <em>small</em>.</h1>
      <p class="deck" data-alt="One bubble per name, sized by the largest share of a year&rsquo;s American births it ever took. Packed top to bottom by the year it crested.">One bubble per name, sized by the largest share of a year's American
        births it ever took. Packed left to right by the year it crested.</p>
    </div>

    <div class="search">
      <input type="text" data-foam-search placeholder="Type your name…" autocomplete="off"
        spellcheck="false" aria-label="Find a name in the field" />
    </div>

    <div class="claim">
      <div class="big n1">4.81%</div>
      <p class="cap">of every American baby born in 1880 was named <b>John</b>. One in twenty-one.</p>
      <div class="big n2">0.67%</div>
      <p class="cap">is the biggest any name has managed since 2010 — <b>Liam</b>, 2024.
        Seven times smaller. Same country, seven times less agreement about what to call a child.</p>
    </div>
  </div>

  <div class="stage">
    <canvas width="1400" height="1026" role="img" tabindex="0" aria-describedby="foam-help"
      data-alt={label + 'top to bottom by the year it crested.'}
      aria-label={label + 'left to right by the year it crested.'}></canvas>
  </div>

  <p id="foam-help" class="sr">Arrow keys move between names, Enter opens the one in focus,
    Escape clears it. Or type a name into the field above.</p>
  <p class="sr" role="status" data-foam-status></p>

  <!-- Below the breakpoint the canvas has no room for the key block, so it is markup. Each
       entry is still a real mark at the field's own scale, painted by the field's own hand. -->
  <div class="keys" data-foam-keys>
    <div class="key">
      <h2>Colour — the name&rsquo;s first letter</h2>
      <canvas data-key="colour" width="340" height="74" aria-hidden="true"></canvas>
    </div>
    <div class="key">
      <h2>Area — its biggest share of a year</h2>
      <canvas data-key="area" width="340" height="80" aria-hidden="true"></canvas>
    </div>
    <div class="key">
      <h2>The arc — years above half that peak</h2>
      <canvas data-key="arc" width="340" height="76" aria-hidden="true"></canvas>
    </div>
    <p class="credit" data-foam-credit></p>
    <!-- not `.method`: story.css already owns that class for the name page's methodology
         block, and its border-top was leaking a stray rule in under the credit -->
    <p class="how">Share = a name&rsquo;s births in a year ÷ all American births that year.
      A name is drawn if it ever took 0.04% of a year; peak is its largest such share, and the
      arc counts the years it stayed above half of it.</p>
  </div>

  <div class="modes">
    {modes.map(m => (
      <button type="button" data-mode={m.key} aria-pressed="false"
        data-slugs={m.items.map(i => i.slug).join(',')}>
        <canvas class="strip" width="680" height="152" aria-hidden="true"></canvas>
        <span class="lbl">{m.label}</span>
        <span class="blurb">{m.blurb}</span>
      </button>
    ))}
  </div>

  <!-- The focused name, on a phone. The wide page draws this panel into the field's own
       clear ground; a phone has no clear ground, so it gets a sheet that is honest about
       covering something — and being an anchor, the whole thing is the way in. -->
  <a class="sheet" data-foam-sheet href="#" tabindex="-1" aria-hidden="true">
    <div class="txt">
      <div class="nm" data-sheet-name></div>
      <div class="meta" data-sheet-meta></div>
      <div class="go">Open its full story →</div>
    </div>
    <canvas class="spark" data-sheet-spark width="132" height="60" aria-hidden="true"></canvas>
  </a>
</section>

<style>
  .foam { margin: 0 0 46px; position: relative; }
  .stage { position: relative; width: 100%; aspect-ratio: 1400 / 1026; }
  .stage canvas { position: absolute; inset: 0; width: 100%; height: 100%;
    touch-action: manipulation; }
  .stage canvas:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  /* The hero text is markup FIRST and an overlay second, so it precedes the canvas in the
     document — which means that on the wide page it needs the z-index to sit over the thing
     it is written on. Two positioned siblings otherwise paint in document order. */
  .ui { position: absolute; inset: 0; z-index: 2; pointer-events: none;
        container-type: inline-size; font-size: clamp(9px, 1.0vw, 14px); }

  .sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

  /* the overlay is sized in cqw so the type tracks the canvas at every width */
  .head { position: absolute; left: 5.14cqw; top: 6.2cqw; }
  .head h1 { margin: 0; max-width: 16ch; text-wrap: balance;
    font: 700 3.07cqw/1.03 var(--display); letter-spacing: -.03em; color: var(--ink); }
  .head h1 em { font-style: normal; color: var(--accent); }
  .deck { margin: 1cqw 0 0; max-width: 40ch; color: var(--ink-soft);
    font: 300 1.07cqw/1.5 var(--display); }

  .search { position: absolute; left: 42.9cqw; top: 6.4cqw; pointer-events: auto; }
  .search input { width: 24.4cqw; padding: .93cqw 1.29cqw; border: .14cqw solid var(--ink);
    border-radius: 999px; background: var(--panel); color: var(--ink);
    font: 300 1.07cqw/1 var(--display); outline: none; }
  .search input::placeholder { color: var(--ink-mute); }
  .search input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .claim { position: absolute; right: 5.14cqw; top: 5.8cqw; width: 20.4cqw; text-align: right; }
  .claim .big { font: 700 3.7cqw/1 var(--display); letter-spacing: -.035em; }
  /* each number in the colour of the name it is about — John J–K, Liam L–M */
  .claim .n1 { color: var(--ink-jk); }
  .claim .n2 { color: var(--ink-lm); }
  .claim .cap { margin: .5cqw 0 1.6cqw; color: var(--ink-soft); font: 300 .9cqw/1.45 var(--display); }
  .claim .cap b { color: var(--ink); font-weight: 500; }
  .claim .cap:last-child { margin-bottom: 0; }

  /* No boxes. Each mode is fronted by the marks it actually lights, drawn at the field's own
     scale in the field's own hand, so the reader sees the thing before choosing it. */
  .modes { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
           gap: 30px; padding-top: 26px; border-top: 1px solid var(--rule); }
  .modes button { text-align: left; padding: 0; border: 0; background: none;
    cursor: pointer; color: inherit; }
  .modes .strip { display: block; width: 100%; max-width: 340px; height: auto; margin-bottom: 12px; }
  .modes .lbl { display: block; font: 500 18px/1.2 var(--display); color: var(--ink); }
  .modes button:hover .lbl { color: var(--accent); }
  .modes button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .modes button[aria-pressed='true'] .lbl { color: var(--accent); }
  .modes button[aria-pressed='true'] .lbl::after { content: ' — lit'; font: 400 12px var(--mono); color: var(--ink-mute); }
  .modes .blurb { display: block; margin-top: 5px; font: 400 13px/1.45 var(--mono); color: var(--ink-soft); }

  /* the canvas draws these on a wide page; markup carries them on a narrow one */
  .keys, .sheet { display: none; }

  @media (max-width: 720px) {
    /* The overlay is only an overlay where there is room beside the field for text. On a
       phone the same elements ARE the page: normal flow, viewport units, above a canvas
       that runs the full width of the glass. */
    .ui { position: static; pointer-events: auto; container-type: normal; font-size: 16px; }
    .head, .search, .claim { position: static; width: auto; text-align: left; }
    .head h1 { max-width: 13ch; font: 700 clamp(31px, 8.8vw, 42px)/1.04 var(--display); }
    .deck { margin: 13px 0 0; max-width: 36ch; font: 300 15px/1.55 var(--display); }

    .search { margin: 22px 0 0; }
    /* 16px is the floor: below it iOS zooms the page the moment the field takes focus */
    .search input { width: 100%; max-width: 330px; padding: 12px 17px; border-width: 1px;
      font: 300 16px/1.25 var(--display); }

    .claim { margin: 26px 0 0; }
    .claim .big { font: 700 clamp(34px, 9.6vw, 44px)/1 var(--display); }
    .claim .cap { margin: 4px 0 20px; max-width: 42ch; font: 300 14px/1.5 var(--display); }

    /* full-bleed: cancel the wrap's own padding rather than measure the viewport, so a
       scrollbar can never make this one gutter wider than the other */
    .stage { width: auto; aspect-ratio: 560 / 2010;
      margin: 30px calc(-1 * clamp(20px, 5vw, 64px)) 0; }
    /* the canvas runs to both edges of the glass, so its focus ring has to come inward or
       the two sides of it are off-screen */
    .stage canvas:focus-visible { outline-offset: -3px; }

    .keys { display: block; margin-top: 30px; padding-top: 24px; border-top: 1px solid var(--rule); }
    .key + .key { margin-top: 22px; }
    .keys h2 { margin: 0 0 8px; font: 600 11px/1.3 var(--mono); letter-spacing: .1em;
      text-transform: uppercase; color: var(--ink-soft); }
    /* CSS owns both dimensions: the script sizes each backing store off the box it is
       actually laid out in, and reads it back on every repaint */
    .keys canvas { display: block; width: 100%; }
    .keys canvas[data-key='colour'] { height: 74px; }
    .keys canvas[data-key='area']   { height: 80px; }
    .keys canvas[data-key='arc']    { height: 76px; }
    .keys .credit { margin: 22px 0 0; font: 400 12px/1.5 var(--mono); color: var(--ink-soft); }
    .keys .how { margin: 6px 0 0; font: 400 12px/1.5 var(--mono); color: var(--ink-mute); }

    .modes { margin-top: 30px; }

    .sheet { display: flex; position: fixed; inset: auto 0 0 0; z-index: 40;
      align-items: center; gap: 14px; padding: 12px 18px calc(12px + env(safe-area-inset-bottom));
      background: var(--panel); border-top: 1px solid var(--rule); color: inherit;
      box-shadow: 0 -10px 30px -18px rgba(29,36,48,.5); text-decoration: none;
      visibility: hidden; transform: translateY(102%);
      transition: transform .34s cubic-bezier(.16,1,.3,1), visibility 0s .34s; }
    .sheet.is-open { visibility: visible; transform: none;
      transition: transform .34s cubic-bezier(.16,1,.3,1); }
    .sheet .txt { flex: 1 1 auto; min-width: 0; }
    .sheet .nm { font: 500 22px/1.15 var(--display); color: var(--ink); }
    .sheet .meta { margin-top: 3px; font: 400 11.5px/1.4 var(--mono); color: var(--ink-soft); }
    .sheet .go { margin-top: 5px; font: 500 12.5px/1 var(--mono); color: var(--accent); }
    .sheet .spark { flex: none; width: 132px; height: 60px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet, .sheet.is-open { transition: none; }
  }
</style>

<script>
  import { mountFoam } from '../scripts/foam.ts';
  const root = document.querySelector<HTMLElement>('[data-foam]');
  if (root) mountFoam(root);
</script>
